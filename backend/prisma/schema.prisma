generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  googleId      String?        @unique
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]     @relation("OwnedDocuments")
  collaborators Collaborator[]
  comments      Comment[]
  history       DocumentHistory[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique // Store a hashed version ideally, or just the token string if you want to keep it simple
  ipAddress    String?
  userAgent    String?
  isSuspicious Boolean  @default(false)
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime
}

model Document {
  id            String         @id @default(uuid())
  title         String         @default("Untitled document")
  ownerId       String
  owner         User           @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  content       Bytes?         // Stores Yjs binary state
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  collaborators Collaborator[]
  comments      Comment[]
  history       DocumentHistory[]
}

enum Role {
  VIEWER
  COMMENTER
  EDITOR
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model Collaborator {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  role       Role         @default(VIEWER)
  status     InviteStatus @default(PENDING)
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt    DateTime     @default(now())

  @@unique([documentId, userId])
}

model Comment {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  text       String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentHistory {
  id              String   @id @default(uuid())
  documentId      String
  userId          String
  contentSnapshot Bytes    // Stores the Yjs binary snapshot at that time
  createdAt       DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
